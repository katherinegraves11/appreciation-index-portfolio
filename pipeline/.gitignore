!/ARCHITECTURE.md
!/BUZZ_PROTOCOL.md
!/FASHION_WEEK_PROTOCOL.md
!/SCAN_MAP.md
!/scripts/
!/scrapers/
!/sql/
!/cloud/
!/site/
*.db
*.db-*
*.sqlite
*.jsonl
*.csv
*.png
*.jpg
*.jpeg
*.heic
*.pdf
*.docx
.env
.env.*
__pycache__/
.DS_Store

# other projects that share this folder
/sql/*founder*
/sql/copenhagen-*
